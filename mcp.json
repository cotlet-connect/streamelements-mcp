{
  "mcpServers": {
    "cotlet": {
      "url": "https://cotlet.dev/mcp/v1",
      "headers": {
        "Authorization": "Bearer ${COTLET_API_KEY}"
      }
    },
    "streamelements": {
      "command": "uvx",
      "args": ["streamelements-mcp"],
      "env": {
        "COTLET_API_KEY": "${COTLET_API_KEY}"
      }
    }
  }
}
